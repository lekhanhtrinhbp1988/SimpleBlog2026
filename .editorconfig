root = true

# Line endings are handled by .gitattributes, so end_of_line is not set here.

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Razor views keep a UTF-8 BOM so Vietnamese text is read correctly
# by every editor and tool.
[*.cshtml]
charset = utf-8-bom

[*.{json,yml,yaml,csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test names use underscores on purpose: acceptance tests start with the AC id
# (AC1_...), unit tests follow Method_Scenario. See docs/adr/0006-code-quality-gates.md.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
