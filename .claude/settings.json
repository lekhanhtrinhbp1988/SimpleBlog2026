{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet build *)",
      "Bash(dotnet test)",
      "Bash(dotnet test *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef *)",
      "Bash(sqllocaldb *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only)",
      "Bash(git branch -D feature/*)",
      "Bash(git branch -D chore/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(dotnet build)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet tool restore)",
      "PowerShell(dotnet ef *)",
      "PowerShell(sqllocaldb *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull --ff-only)",
      "PowerShell(git branch -D feature/*)",
      "PowerShell(git branch -D chore/*)",
      "PowerShell(git push -u origin feature/*)",
      "PowerShell(git push -u origin chore/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git push * main*)",
      "Bash(gh pr merge *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * :*)",
      "PowerShell(git push * main*)",
      "PowerShell(gh pr merge *)"
    ]
  }
}
