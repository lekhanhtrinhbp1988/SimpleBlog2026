{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet build *)",
      "Bash(dotnet test)",
      "Bash(dotnet test *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef *)",
      "Bash(sqllocaldb *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(dotnet build)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet tool restore)",
      "PowerShell(dotnet ef *)",
      "PowerShell(sqllocaldb *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  }
}
