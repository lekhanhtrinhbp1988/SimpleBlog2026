# Store text files with LF in the repository; Git converts to the platform's
# native line ending on checkout (CRLF on Windows, LF on Linux and CI).
* text=auto

# Scripts that must keep a fixed line ending regardless of platform
*.sh  text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
